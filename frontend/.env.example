# Next.js Environment Variables
# This file is automatically loaded by Next.js in development and production

# Strapi Backend Configuration
STRAPI_API_URL=tobechanged  
STRAPI_API_TOKEN=tobechanged

# Site Configuration
# Canonical production domain (used by metadataBase, sitemap, robots.txt, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://elisahorta.com.co
NEXT_PUBLIC_SITE_NAME=tobechanged
NEXT_PUBLIC_FEATURE_CART=false

# Third-party Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
